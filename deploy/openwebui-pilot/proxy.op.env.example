# Copy the existing op.env and use UPSTREAM provider credentials, not a LiteLLM
# virtual key. Resolve these only with op run or the Ansible injection wrapper.
PROXY_MASTER_KEY=op://YOUR_VAULT/Proxy/master-key
OPENAI_API_KEY=op://YOUR_VAULT/OpenAI/api-key
ANTHROPIC_API_KEY=op://YOUR_VAULT/Anthropic/api-key
OPENROUTER_API_KEY=op://YOUR_VAULT/OpenRouter/api-key
OIDC_CLIENT_ID=op://YOUR_VAULT/Proxy/oidc-client-id
OIDC_CLIENT_SECRET=op://YOUR_VAULT/Proxy/oidc-client-secret
OIDC_ISSUER_URL=https://your-idp.example
OIDC_REDIRECT_URL=http://localhost:5173/auth/callback
# Remote Ollama, including the OpenAI-compatible /v1 suffix:
OLLAMA_API_BASE=http://your-ollama-host:11434/v1
